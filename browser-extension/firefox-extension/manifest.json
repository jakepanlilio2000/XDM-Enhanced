{
    "name": "XDM Enhanced - Browser Integration",
    "browser_action": {
        "default_title": "XDM Enhanced",
        "default_icon": {
            "16": "icon16-mono.png",
            "48": "icon48-mono.png",
            "128": "icon128-mono.png"
        }
    },
    "manifest_version": 2,
    "version": "1.1.3",
    "description": "Send downloads, web videos and links from Firefox to XDM Enhanced. Fast, modern open-source download manager.",
    "homepage_url": "https://github.com/jakepanlilio2000/XDM-Enhanced",
    "permissions": [
        "tabs",
        "cookies",
        "menus",
        "webRequest",
        "webRequestBlocking",
        "storage",
        "*://*/*"
    ],
    "commands": {
        "open-bulk": {
            "suggested_key": {
                "default": "Alt+Shift+D"
            },
            "description": "Grab all links for this page with XDM Enhanced"
        }
    },
    "options_ui": {
        "page": "app/options.html",
        "open_in_tab": true
    },
    "background": {
        "page": "main.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "xdm-enhanced-browser-monitor@jakepanlilio2000.github.io",
            "strict_min_version": "109.0",
            "update_url": "https://raw.githubusercontent.com/jakepanlilio2000/XDM-Enhanced/master/browser-extension/updates.json",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
