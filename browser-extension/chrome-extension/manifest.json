{
    "name": "XDM Enhanced - Browser Integration",
    "action": {
        "default_title": "XDM Enhanced",
        "default_icon": {
            "16": "icon16-mono.png",
            "48": "icon48-mono.png",
            "128": "icon128-mono.png"
        }
    },
    "manifest_version": 3,
    "version": "3.5.4",
    "version_name": "1.0.0-rc.1",
    "description": "Send downloads, web videos and links from Chrome to XDM Enhanced. Fast, modern open-source download manager.",
    "homepage_url": "https://github.com/jakepanlilio2000/XDM-Enhanced",
    "minimum_chrome_version": "103",
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "cookies",
        "webRequest",
        "storage",
        "contextMenus",
        "alarms",
        "scripting"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "overlay.js"
            ],
            "css": [
                "overlay.css"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "commands": {
        "open-bulk": {
            "suggested_key": {
                "default": "Alt+Shift+D"
            },
            "description": "Grab all links for this page with XDM Enhanced"
        }
    },
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}
