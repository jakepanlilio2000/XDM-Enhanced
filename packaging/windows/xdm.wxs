<?xml version="1.0" encoding="UTF-8"?>
<!--
  XDM 9 MSI (PACKAGING.md §5). Built by packaging\build-bundle.ps1 -Type msi from the jpackage app image:

    wix build xdm.wxs -arch x64|arm64 -ext WixToolset.Util.wixext -ext WixToolset.UI.wixext
              -bindpath AppImage=<image dir> -d Version=<a.b.c> -d IconFile=<ico> -d LicenseRtf=<rtf>

  Needs WiX 7 or later: Scope="perMachineOrUser" does not exist before v7.0.0 (v6 only has perUserOrMachine,
  which defaults to a per-user install).

  x64 and arm64 are separate MSIs with the same UpgradeCode, so either one upgrades the other.
-->
<?if $(sys.BUILDARCH) != "x64" AND $(sys.BUILDARCH) != "arm64" ?>
<?error XDM is built for -arch x64 or -arch arm64 only ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Dedicated UpgradeCode for XDM Enhanced so it does not conflict with or uninstall official upstream XDM. -->
  <Package Name="XDM Enhanced" Manufacturer="XDM Enhanced Contributors" Language="1033"
           Version="$(var.Version)" UpgradeCode="C6A8025B-6D3E-45E9-9BD1-314644B272C1"
           Scope="perMachineOrUser" Compressed="yes">
    <SummaryInformation Description="XDM Enhanced" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of XDM Enhanced is already installed." />

    <!-- On Windows 10 the Installer reports 8.1's version, so this lets 8.1 through too; JDK 25 needs 10. -->
    <Launch Condition="Installed OR VersionNT &gt; 602"
            Message="XDM Enhanced needs Windows 10 or later." />

    <!-- Prevent concurrent per-user and per-machine installs fighting over resources. -->
    <Property Id="XDM_MACHINE">
      <RegistrySearch Root="HKLM" Key="Software\XDM Enhanced" Name="Installed" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="XDM_USER">
      <RegistrySearch Root="HKCU" Key="Software\XDM Enhanced" Name="Installed" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT (MSIINSTALLPERUSER = 1 AND XDM_MACHINE)"
            Message="XDM Enhanced is already installed for all users on this computer." />
    <Launch Condition="Installed OR MSIINSTALLPERUSER = 1 OR NOT XDM_USER"
            Message="XDM Enhanced is installed for your account only. Uninstall it from Settings &gt; Apps first." />
    <!-- §5.8: the collector. ZGC needs Windows 10 1803 (build 17134) or later; the JVM exits at startup on older
         builds. The Installer's own VersionNT/WindowsBuild report 8.1 on Windows 10 (msiexec's manifest), so
         the build comes from the registry: a REG_SZ of digits, which a condition compares as an integer (a
         missing or non-numeric value compares false, so G1). XDMGC=G1 on the msiexec command line forces G1
         (testing, support). XdmGc picks the launcher config and archive components in AppImageGc below; they
         are transitive, so a repair after a Windows upgrade re-picks. -->
    <Property Id="XDMWINBUILD" Secure="yes">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber"
                      Type="raw" Bitness="always64" />
    </Property>
    <Property Id="XDMGC" Secure="yes" />
    <Property Id="XdmGc" Value="g1" />
    <SetProperty Id="XdmGc" Value="zgc" After="AppSearch" Sequence="both"
                 Condition="XDMWINBUILD &gt;= 17134 AND NOT (XDMGC ~= &quot;G1&quot;)" />
    <!-- §5.4: the login entry. Read before install, as the installing user, to keep their choice on upgrade. -->
    <Property Id="XDM_RUN">
      <RegistrySearch Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="XDM Enhanced" Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- §5.3: end every running XDM Enhanced, including other users'. Timeout is
         in seconds (WiX multiplies it by 1000). RebootPrompt must be off: WiX rejects it together with
         TerminateProcess, and its default is on. -->
    <util:CloseApplication Id="CloseXdm" Target="xdm-app.exe" CloseMessage="yes" ElevatedCloseMessage="yes"
                           TerminateProcess="1" Timeout="5" RebootPrompt="no" Property="XDMWASRUNNING" />
    <!-- When XDM was running, wait 5 s before copying files. -->
    <SetProperty Id="XdmWaitAfterClose" Sequence="execute" Before="XdmWaitAfterClose"
                 Value="&quot;[System64Folder]waitfor.exe&quot; /t 5 XdmInstallerPause" />
    <CustomAction Id="XdmWaitAfterClose" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <SetProperty Id="WixQuietExecCmdLine" Sequence="execute" Before="XdmKillBeforeValidate"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /f /im xdm-app.exe" />
    <CustomAction Id="XdmKillBeforeValidate" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="XdmKillBeforeValidate" Before="InstallValidate" />
      <Custom Action="XdmWaitAfterClose" After="Wix4CloseApplications_$(sys.BUILDARCHSHORT)" Condition="XDMWASRUNNING" />
    </InstallExecuteSequence>

    <Icon Id="XdmIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="XdmIcon" />

    <!-- Per-user installs (MSIINSTALLPERUSER=1) are redirected to %LOCALAPPDATA%\Programs\XDM Enhanced. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="XDM Enhanced" />
    </StandardDirectory>

    <Feature Id="Main" Title="XDM Enhanced" Level="1">
      <ComponentGroupRef Id="AppImage" />
      <ComponentGroupRef Id="AppImageGc" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentGroupRef Id="AutoStart" />
      <ComponentGroupRef Id="UrlScheme" />
    </Feature>

    <!-- UI: licence, install folder, and "Launch XDM Enhanced" on the last page. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch XDM Enhanced" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixUnelevatedShellExecTarget" Value="xdm-app.exe" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Property="WixUnelevatedShellExecTarget"
               Value="[INSTALLFOLDER]xdm-app.exe" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="Wix4UnelevatedShellExec_$(sys.BUILDARCHSHORT)" Order="2"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- The Run value and the xdm-app:// keys are the AutoStart and UrlScheme components below (§5.4). -->
  </Package>

  <Fragment>
    <!-- The whole jpackage app image: xdm-app.exe, app\ (FlatLaf DLL; Conscrypt DLL on x64;
         jit-directives.json on arm64) and
         runtime\, whose lib\modules holds the app classes (module xdm.app). The launcher configs and
         archives are AppImageGc's. Cabinets store file times as local time, so installed mtimes are off by
         the build/install time-zone gap; AppCDS doesn't check the runtime image's mtime (§5.6). -->
    <ComponentGroup Id="AppImage" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.AppImage)\**">
        <Exclude Files="!(bindpath.AppImage)\app\xdm-app.cfg" />
        <Exclude Files="!(bindpath.AppImage)\app\xdm-app.cfg.zgc" />
        <Exclude Files="!(bindpath.AppImage)\app\xdm.jsa" />
        <Exclude Files="!(bindpath.AppImage)\app\xdm-zgc.jsa" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- §5.8: one collector per install, G1 or ZGC (XdmGc): its launcher config as app\xdm-app.cfg and its
         AppCDS archive. The two config components install the same file name, so their GUIDs are fixed here
         (a derived GUID would be the same for both); keep them in every version, so an update on the same
         machine shares the component. The archives have their own names, so their GUIDs are derived. -->
    <ComponentGroup Id="AppImageGc" Directory="INSTALLFOLDER" Subdirectory="app">
      <Component Id="LauncherCfgG1" Guid="C2753277-7FCA-41EA-93CA-1EB8C5D80166" Transitive="yes"
                 Condition="XdmGc &lt;&gt; &quot;zgc&quot;">
        <File Id="LauncherCfgG1" Source="!(bindpath.AppImage)\app\xdm-app.cfg" Name="xdm-app.cfg" />
      </Component>
      <Component Id="LauncherCfgZgc" Guid="41D8A2E8-626C-4E5F-B0D1-7F46D883E4C2" Transitive="yes"
                 Condition="XdmGc = &quot;zgc&quot;">
        <File Id="LauncherCfgZgc" Source="!(bindpath.AppImage)\app\xdm-app.cfg.zgc" Name="xdm-app.cfg" />
      </Component>
      <Component Id="CdsArchiveG1" Transitive="yes" Condition="XdmGc &lt;&gt; &quot;zgc&quot;">
        <File Id="CdsArchiveG1" Source="!(bindpath.AppImage)\app\xdm.jsa" />
      </Component>
      <Component Id="CdsArchiveZgc" Transitive="yes" Condition="XdmGc = &quot;zgc&quot;">
        <File Id="CdsArchiveZgc" Source="!(bindpath.AppImage)\app\xdm-zgc.jsa" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- HKMU is HKLM for a per-machine install and HKCU for a per-user one; the value doubles as the marker
         the launch conditions above look for. -->
    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="XDM Enhanced" Description="XDM Enhanced"
                  Target="[INSTALLFOLDER]xdm-app.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\XDM Enhanced" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- [ProductCode] is written into the shortcut at install time. Every build has a new ProductCode; an update
           removes the old version (and its shortcut) first, then writes this one. msiexec /x works without
           elevation for a per-user install. -->
      <Component Id="UninstallShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="UninstallShortcut" Name="Uninstall XDM Enhanced"
                  Description="Uninstall XDM Enhanced"
                  Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
        <RegistryValue Root="HKMU" Key="Software\XDM Enhanced" Name="UninstallShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="DesktopShortcut" Name="XDM Enhanced" Description="XDM Enhanced"
                  Target="[INSTALLFOLDER]xdm-app.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\XDM Enhanced" Name="DesktopShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- start on login, for the installing user (HKCU in both scopes: an HKLM value can't be switched off
         per user without elevation). -->
    <ComponentGroup Id="AutoStart" Directory="INSTALLFOLDER">
      <Component Id="AutoStartRunValue"
                 Condition="UserSID &lt;&gt; &quot;S-1-5-18&quot; AND (NOT WIX_UPGRADE_DETECTED OR XDM_RUN)">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="XDM Enhanced" Type="string"
                       Value="&quot;[INSTALLFOLDER]xdm-app.exe&quot; --minimized" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- xdm-app:// lets a browser start XDM by opening a link. -->
    <ComponentGroup Id="UrlScheme" Directory="INSTALLFOLDER">
      <Component Id="UrlSchemeKeys">
        <RegistryKey Root="HKMU" Key="Software\Classes\xdm-app">
          <RegistryValue Type="string" Value="URL:XDM Enhanced Protocol" KeyPath="yes" />
          <!-- The marker that makes the key a URL scheme; its (empty) data is ignored. -->
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]xdm-app.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
